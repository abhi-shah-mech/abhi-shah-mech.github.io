---
import { getCollection, render } from "astro:content";
import { ArrowLeft, ArrowRight } from "lucide-react";
import settings from "../../../config/settings.yaml";
import Footer from "../../components/Footer.astro";
import Layout from "../../layouts/Layout.astro";
import VideoCard from "../../components/VideoCard.jsx";
import ImageCard from "../../components/ImageCard.jsx";

export async function getStaticPaths() {
    const articles = await getCollection("projects");
    return articles.map((article: any) => {
        return {
            params: { slug: article.data.slug },
            props: { article },
        };
    });
}

const { article } = Astro.props;
const images = article?.data?.images?.map((image: any) => {
    return {
        ...image,
        src: `${settings.base_url}/project-images/${image.src}`,
    };
});
const videos = article?.data?.videos?.map((video: any) => {
    return {
        ...video,
        thumbnail: `${settings.base_url}/project-images/${video.thumbnail}`,
        src: video.src.startsWith("http")
            ? video.src
            : `${settings.base_url}/project-videos/${video.src}`,
    };
});
const processImages = article?.data?.process_images?.map((item: any) => {
    if (item.thumbnail) {
        // process step is a video
        return {
            ...item,
            thumbnail: `${settings.base_url}/project-images/${item.thumbnail}`,
            src: item.src.startsWith("http")
                ? item.src
                : `${settings.base_url}/project-videos/${item.src}`,
        };
    }
    return {
        ...item,
        src: `${settings.base_url}/project-images/${item.src}`,
    };
});
// consecutive process_images entries sharing the same `group` number are
// stacked together in a single column instead of each getting their own
const processGroups: any[][] = [];
for (const item of processImages ?? []) {
    const lastGroup = processGroups[processGroups.length - 1];
    if (item.group !== undefined && lastGroup && lastGroup[0].group === item.group) {
        lastGroup.push(item);
    } else {
        processGroups.push([item]);
    }
}

const processColumns = article?.data?.process_columns;
// Tailwind needs literal class names to generate the CSS, so map known
// column counts to literal strings rather than interpolating the number
const gridColsClass: Record<number, string> = {
    2: "md:grid-cols-2",
    3: "md:grid-cols-3",
    4: "md:grid-cols-4",
    5: "md:grid-cols-5",
};

const { Content } = await render(article);

const proseClasses = `prose max-w-none
    prose-a:text-primary
    prose-li:marker:text-base-100/50
    prose-h1:text-white
    prose-h2:text-primary
    prose-p:text-base-100
    prose-li:text-base-200
    list-disc`;
---

<Layout title={article?.data?.title}>
    <div class="pb-8 pt-20 container mx-auto px-5">
        <div class="mb-5">
            <a class="btn btn-ghost" href=`${settings.base_url}/#portfolio`>
                <ArrowLeft /> Home
            </a>
        </div>

        {
            processImages && processImages.length > 0 ? (
                <Fragment>
                    <!-- PROCESS layout: title, then a step-by-step image flow, then full-width text -->
                    <h1 class="text-3xl md:text-5xl font-black text-white mb-10">
                        {article?.data?.title}
                    </h1>

                    {processColumns ? (
                        <!-- plain grid, no arrows -->
                        <div class={`grid grid-cols-1 ${gridColsClass[processColumns] ?? "md:grid-cols-3"} gap-3 mb-14`}>
                            {processGroups.map((group: any[]) => (
                                <div class="flex flex-col gap-3">
                                    {group.map((item: any) => (
                                        item.thumbnail ? (
                                            <VideoCard client:only="react" video={item} />
                                        ) : (
                                            <ImageCard client:only="react" image={item} />
                                        )
                                    ))}
                                </div>
                            ))}
                        </div>
                    ) : (
                        <!-- arrow-connected flow -->
                        <div class="flex flex-col lg:flex-row items-center gap-3 mb-14">
                            {processGroups.map((group: any[], index: number) => (
                                <Fragment>
                                    <div class="w-full lg:flex-1 lg:max-w-md flex flex-col gap-3">
                                        {group.map((item: any) => (
                                            item.thumbnail ? (
                                                <VideoCard client:only="react" video={item} />
                                            ) : (
                                                <ImageCard client:only="react" image={item} />
                                            )
                                        ))}
                                    </div>
                                    {index < processGroups.length - 1 && !processGroups[index + 1][0].no_arrow && (
                                        <ArrowRight
                                            className="shrink-0 text-primary rotate-90 lg:rotate-0"
                                            size={32}
                                        />
                                    )}
                                </Fragment>
                            ))}
                        </div>
                    )}

                    <div class={proseClasses}>
                        <Content />
                    </div>
                </Fragment>
            ) : article?.data?.layout === "split" ? (
                <Fragment>
                    <!-- TITLE: full width, above the split -->
                    <h1 class="text-3xl md:text-5xl font-black text-white mb-10">
                        {article?.data?.title}
                    </h1>

                    <div class="grid gap-8 grid-cols-1 lg:grid-cols-3 items-start">
                        <!-- TEXT: 2/3 width; below images on mobile, left on desktop -->
                        <div class={`${proseClasses} order-2 lg:order-1 lg:col-span-2`}>
                            <Content />
                        </div>

                        <!-- IMAGES: 1/3 width sidebar; above text on mobile, right on desktop -->
                        <div class="order-1 lg:order-2 lg:sticky lg:top-24 self-start h-fit w-full">
                            <div class="grid grid-cols-1 gap-4">
                                {images?.map((image: any) => (
                                    <ImageCard client:only="react" image={image} />
                                ))}
                                {videos?.map((video: any) => (
                                    <VideoCard client:only="react" video={video} />
                                ))}
                            </div>
                        </div>
                    </div>
                </Fragment>
            ) : (
                <div class="grid gap-8 grid-cols-1 lg:grid-cols-2 items-start">
                    <!-- TEXT: appears first on mobile -->
                    <div class={proseClasses}>
                        <Content />
                    </div>

                    <!-- IMAGES: below text on mobile, sticky on md+ -->
                    <div class="lg:sticky lg:top-24 self-start h-fit">
                        <div class="grid grid-cols-1 lg:grid-cols-2 5xl:grid-cols-3 gap-4">
                            {videos?.map((video: any) => (
                                <VideoCard client:only="react" video={video} />
                            ))}
                            {images?.map((image: any) => (
                                <ImageCard client:only="react" image={image} />
                            ))}
                        </div>
                    </div>
                </div>
            )
        }
    </div>
    <Footer />
</Layout>
