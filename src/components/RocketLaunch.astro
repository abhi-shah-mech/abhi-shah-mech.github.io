---
// Scroll-linked rocket: ignites over the first bit of scroll, then climbs
// out of the viewport as the reader works down the page.
// Deterministic pseudo-random so the cloud looks the same every build.
const rand = (i: number, k: number) => {
  const x = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const puffs = Array.from({ length: 16 }, (_, i) => ({
  dx: Math.round((rand(i, 1) - 0.5) * 240),
  dy: -Math.round(rand(i, 2) * 90),
  size: Math.round(36 + rand(i, 3) * 56),
}));
const sparks = Array.from({ length: 14 }, (_, i) => {
  // Fan upward and outward from the pad.
  const angle = Math.PI * (0.05 + 0.9 * (i / 13)) + (rand(i, 4) - 0.5) * 0.2;
  const dist = 70 + rand(i, 5) * 90;
  return {
    dx: Math.round(Math.cos(angle) * dist),
    dy: -Math.round(Math.sin(angle) * dist),
  };
});
---

<div id="rocket-launch" class="rocket-launch hidden xl:block" aria-hidden="true">
  <div class="rocket-trail"></div>

  {puffs.map((p) => (
    <span
      class="rocket-puff"
      style={`--dx:${p.dx}px; --dy:${p.dy}px; --size:${p.size}px;`}
    ></span>
  ))}

  <span class="rocket-flash"></span>
  <span class="rocket-shock"></span>

  {sparks.map((p) => (
    <span class="rocket-spark" style={`--dx:${p.dx}px; --dy:${p.dy}px;`}></span>
  ))}

  <div class="rocket-flight">
    <div class="rocket-body">
      <svg viewBox="0 0 60 160" class="rocket-svg">
        <!-- Exhaust -->
        <g class="rocket-flame">
          <path d="M21 108 Q30 168 39 108 Z" fill="#f97316" />
          <path d="M24 108 Q30 150 36 108 Z" fill="#fbbf24" />
          <path d="M27 108 Q30 132 33 108 Z" fill="#fef3c7" />
        </g>
        <!-- Fins -->
        <path d="M17 76 L3 106 L3 112 L17 102 Z" class="rocket-accent" />
        <path d="M43 76 L57 106 L57 112 L43 102 Z" class="rocket-accent" />
        <!-- Nozzle -->
        <path d="M22 100 L38 100 L40 109 L20 109 Z" fill="#57534e" />
        <!-- Fuselage -->
        <path d="M30 2 C41 16 44 32 44 48 L44 102 L16 102 L16 48 C16 32 19 16 30 2 Z" fill="#e7e5e4" />
        <path d="M30 2 C41 16 44 32 44 48 L44 102 L36 102 L36 48 C36 30 34 16 30 2 Z" fill="#a8a29e" opacity="0.35" />
        <!-- Nose cone -->
        <path d="M30 2 C37 11 40.5 19 42 28 L18 28 C19.5 19 23 11 30 2 Z" class="rocket-accent" />
        <!-- Band + centre fin -->
        <rect x="16" y="86" width="28" height="4" class="rocket-accent" />
        <rect x="28.5" y="90" width="3" height="16" fill="#78716c" />
        <!-- Window -->
        <circle cx="30" cy="52" r="8" fill="#57534e" />
        <circle cx="30" cy="52" r="5.5" fill="#0e7490" />
        <circle cx="28" cy="50" r="1.8" fill="#a5f3fc" />
      </svg>
    </div>
  </div>

  <!-- Launch pad -->
  <svg viewBox="0 0 120 24" class="rocket-pad">
    <path d="M14 0 L14 20 M24 0 L24 20 M14 4 L24 10 M24 4 L14 10 M14 10 L24 16 M24 10 L14 16" stroke="#57534e" stroke-width="1.5" fill="none" />
    <rect x="30" y="16" width="60" height="4" rx="1" fill="#57534e" />
    <rect x="0" y="20" width="120" height="4" fill="#292524" />
  </svg>
</div>

<style>
  .rocket-launch {
    --pad-h: 24px;
    position: fixed;
    top: 4rem; /* navbar height */
    right: 1rem;
    bottom: 0;
    width: 120px;
    z-index: 20;
    pointer-events: none;
  }

  .rocket-pad {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 120px;
    height: var(--pad-h);
  }

  .rocket-flight {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pad-h) - 12px);
    width: 56px;
    margin-left: -28px;
    transform: translateY(calc(var(--lift-px, 0) * -1px));
    will-change: transform;
  }

  .rocket-svg {
    display: block;
    width: 56px;
    height: auto;
    overflow: visible;
  }

  .rocket-accent {
    fill: var(--color-primary);
  }

  .rocket-flame {
    transform-box: fill-box;
    transform-origin: 50% 0;
    transform: scaleY(var(--flame, 0));
    opacity: min(1, calc(var(--flame, 0) * 3));
  }

  .rocket-launch.is-lit .rocket-flame path {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: flicker 0.12s ease-in-out infinite alternate;
  }

  .rocket-launch.is-rumbling .rocket-body {
    animation: rumble 0.09s linear infinite;
  }

  .rocket-puff {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pad-h) - 4px);
    width: var(--size);
    height: var(--size);
    margin-left: calc(var(--size) / -2);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(231, 229, 228, 0.6), rgba(168, 162, 158, 0.25) 45%, rgba(168, 162, 158, 0) 70%);
    transform: translate(calc(var(--dx) * var(--smoke, 0)), calc(var(--dy) * var(--smoke, 0)))
      scale(calc(0.3 + var(--smoke, 0) * 1.6));
    opacity: var(--smoke-o, 0);
  }

  .rocket-flash {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pad-h) - 60px);
    width: 180px;
    height: 180px;
    margin-left: -90px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(254, 243, 199, 0.95), rgba(251, 191, 36, 0.6) 30%, rgba(249, 115, 22, 0.25) 55%, rgba(249, 115, 22, 0) 70%);
    transform: scale(calc(0.2 + var(--flash, 0) * 1.3));
    opacity: var(--flash, 0);
    mix-blend-mode: screen;
  }

  .rocket-shock {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pad-h) - 40px);
    width: 80px;
    height: 80px;
    margin-left: -40px;
    border-radius: 50%;
    border: 3px solid rgba(254, 243, 199, 0.8);
    transform: scale(calc(0.2 + var(--shock, 0) * 4)) scaleY(0.45);
    opacity: calc((1 - var(--shock, 0)) * var(--shock-on, 0));
  }

  .rocket-spark {
    position: absolute;
    left: 50%;
    bottom: var(--pad-h);
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: #fde68a;
    box-shadow: 0 0 6px 2px rgba(251, 146, 60, 0.8);
    transform: translate(calc(var(--dx) * var(--burst, 0)), calc(var(--dy) * var(--burst, 0) + 60px * var(--burst, 0) * var(--burst, 0)));
    opacity: calc(var(--burst-on, 0) * (1 - var(--burst, 0)));
  }

  .rocket-trail {
    position: absolute;
    left: 50%;
    bottom: var(--pad-h);
    width: 14px;
    margin-left: -7px;
    height: calc(var(--lift-px, 0) * 1px);
    background: linear-gradient(to top, rgba(231, 229, 228, 0.28), rgba(231, 229, 228, 0.06));
    filter: blur(5px);
    border-radius: 7px;
    opacity: var(--trail-o, 0);
  }

  @keyframes flicker {
    from { transform: scaleY(0.85) scaleX(1.05); }
    to { transform: scaleY(1.1) scaleX(0.95); }
  }

  @keyframes rumble {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-0.8px, 0.4px); }
    50% { transform: translate(0.8px, -0.4px); }
    75% { transform: translate(-0.5px, -0.3px); }
    100% { transform: translate(0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rocket-launch.is-lit .rocket-flame path,
    .rocket-launch.is-rumbling .rocket-body {
      animation: none;
    }
  }
</style>

<script>
  const el = document.getElementById("rocket-launch");
  if (el) {
    // Scroll distances (px) for each phase of the launch.
    const IGNITION = 120; // engine spools up on the pad
    const BURST = 260; // explosion at liftoff, overlapping the first climb
    const SMOKE_HANG = 700; // how long the ground cloud lingers
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let ticking = false;

    function update() {
      ticking = false;
      const y = window.scrollY;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);

      const ignite = clamp(y / IGNITION);
      const lift = clamp((y - IGNITION) / Math.max(1, maxScroll - IGNITION));
      // Quick off the pad so the first scrolls feel like a launch, then a
      // steady climb for the rest of the page.
      const eased = Math.pow(lift, 0.7);
      const travel = el!.clientHeight + 200;
      const liftPx = eased * travel;

      const burst = clamp((y - IGNITION * 0.6) / BURST);
      const burstOn = y > IGNITION * 0.6 && burst < 1 ? 1 : 0;
      const flash = burstOn * Math.sin(Math.PI * clamp(burst * 1.6));
      const smokeGrow = clamp(ignite * 0.5 + burst * 0.8);
      const smokeFade = clamp((y - IGNITION - BURST) / SMOKE_HANG);

      const set = (k: string, v: number) => el!.style.setProperty(k, v.toFixed(3));
      set("--lift-px", liftPx);
      set("--flame", ignite * (1 + burst * 0.4 + lift * 0.4));
      set("--smoke", smokeGrow);
      set("--smoke-o", clamp(ignite * 1.5) * 0.95 * (1 - smokeFade));
      set("--flash", flash);
      set("--burst", burst);
      set("--burst-on", burstOn);
      set("--shock", clamp(burst * 1.4));
      set("--shock-on", burstOn);
      set("--trail-o", clamp(lift * 20) * (1 - lift * 0.6));

      el!.classList.toggle("is-lit", ignite > 0);
      el!.classList.toggle("is-rumbling", ignite > 0.2 && burst < 0.6);
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
</script>
