---
import { ArrowDownToLine, LayoutGrid } from "lucide-react";
import settings from "../../config/settings.yaml";
import hero from "./../../contents/hero.yaml";
---

<section
  class="px-4 pt-8 md:pt-32"
  style={`background-image: url('${settings.base_url}/hero-bg.png'); background-size: cover; background-position: center; padding-bottom: ${settings.vertical_spacing}px;`}
>
  <div class="mt-24 md:mt-0 md:pt-0 flex flex-col justify-center text-base-100">
    <!-- Main hero content -->
    <div class="w-full max-w-[90rem] mx-auto flex flex-col items-center text-center">
    <div class="mb-4 inline-block rounded-full p-1 md:p-1.5 bg-gradient-to-b from-primary to-transparent">
      <img
        src={`${settings.base_url}/portrait.jpg`}
        alt="Abhishek Shah"
        class="rounded-full size-32 md:size-52"
      />
      </div>

      <!-- Split name and title onto separate lines -->
      <h1 class="text-3xl md:text-5xl font-black leading-tight">
        <span class="text-primary">{hero.hero_name}</span>
      </h1>
      <h2 class="text-2xl md:text-4xl font-black leading-tight">
        {hero.hero_title}
      </h2>

      <p class="md:text-2xl mt-4 mb-5 md:mb-6 whitespace-pre-line leading-tight">
        {hero.hero_subtitle}
      </p>

            <!-- CTA block: increased spacing between buttons on desktop -->
      <div class="mt-6 mb-8 md:mt-8 md:mb-12 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-12">
        
        <!-- Portfolio button: no border at rest, border + glow on hover -->
        <a
          href={`${settings.base_url}/#portfolio`}
          class="btn btn-lg md:btn-xl
                 border border-transparent
                 hover:border-primary
                 hover:bg-primary
                 hover:shadow-[0_0_0_3px_rgba(34,211,238,0.35)]
                 transition-[border,background-color,box-shadow]"
        >
          View Projects <LayoutGrid />
        </a>
      
        <!-- Resume button: no border at rest, border + glow on hover -->
        <a
          target="_blank"
          href={`${settings.base_url}/downloads/${settings.resume_file}`}
          class="btn btn-lg md:btn-xl btn-ghost
                 border border-transparent
                 hover:border-primary
                 hover:shadow-[0_0_0_3px_rgba(34,211,238,0.35)]
                 transition-[border,box-shadow]
                 flex items-center justify-center group relative overflow-hidden"
        >
          <span class="flex items-center justify-center transition-transform duration-300 transform group-hover:-translate-y-full w-full">
            Download Resume (PDF) <ArrowDownToLine />
          </span>
          <span
            class="flex items-center justify-center absolute top-full left-0 w-full h-full
                   transition-transform duration-300 transform group-hover:-translate-y-full
                   bg-primary text-base-content"
          >
            Download Resume (PDF) <ArrowDownToLine />
          </span>
        </a>
      
      </div>


    <!-- Capability chips -->
    {hero.capability_chips?.length > 0 && (
      <div class="w-full max-w-[90rem] mx-auto mt-3 md:mt-4 flex flex-wrap justify-center gap-3 px-4">
        {hero.capability_chips.map((chip) => (
          <span class="capability-chip">{chip}</span>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .capability-chip {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
</style>
