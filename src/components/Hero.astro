---
import { ArrowDownToLine, LayoutGrid } from "lucide-react";
import settings from "../../config/settings.yaml";
import hero from "./../../contents/hero.yaml";
---

<section
  class="px-4 pt-8 md:pt-32"
  style={`background-image: url('${settings.base_url}/hero-bg.png'); background-size: cover; background-position: center; padding-bottom: ${settings.vertical_spacing}px;`}
>
  <div class="mt-24 md:mt-0 md:pt-0 flex flex-col justify-center text-base-100">
    <!-- Main hero content -->
    <div class="max-w-4xl container mx-auto flex flex-col items-center text-center">
      <img
        src={`${settings.base_url}/portrait.jpg`}
        alt="Abhishek Shah"
        class="rounded-full size-32 mb-4 md:size-52 border-8 border-white/10"
      />

      <h1 class="text-3xl md:text-5xl font-black">
        <span class="text-primary">{hero.hero_name}</span> - {hero.hero_title}
      </h1>

      <p class="md:text-2xl text-secondary mt-3 mb-5 md:mb-6">
        {hero.hero_subtitle}
      </p>

      <!-- CTA block: increased vertical spacing above and below -->
      <div class="mt-6 mb-8 md:mt-8 md:mb-12 grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href={`${settings.base_url}/#portfolio`}
          class="btn hover:bg-secondary btn-lg md:btn-xl"
        >
          View Projects <LayoutGrid />
        </a>

        <a
          target="_blank"
          href={`${settings.base_url}/downloads/${settings.resume_file}`}
          class="btn btn-lg flex items-center justify-center md:btn-xl btn-ghost group relative overflow-hidden"
        >
          <span
            class="flex items-center justify-center transition-transform duration-300 transform group-hover:-translate-y-full w-full"
          >
            Download Resume (PDF) <ArrowDownToLine />
          </span>
          <span
            class="flex items-center justify-center absolute top-full left-0 w-full h-full transition-transform duration-300 transform group-hover:-translate-y-full bg-base-100 text-base-content"
          >
            Download Resume (PDF) <ArrowDownToLine />
          </span>
        </a>
      </div>
    </div>

    <!-- Capability chips -->
    {hero.capability_chips?.length > 0 && (
      <div class="max-w-4xl container mx-auto mt-3 md:mt-4 flex flex-wrap justify-center gap-3 px-4">
        {hero.capability_chips.map((chip) => (
          <span class="capability-chip">{chip}</span>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .capability-chip {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
</style>
