---
import { getCollection } from "astro:content";
import projects from "../../contents/projects.yaml";
import ProjectCard from "./ProjectCard.astro";
import { CATEGORIES } from "../content.config";
const items = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
);
import settings from "../../config/settings.yaml";

const filters = ["All", ...CATEGORIES];
---

<section
    id="portfolio"
    style={`padding-bottom: ${settings.vertical_spacing}px;`}
    class="flex flex-col gap-4 items-center justify-center container mx-auto px-4"
>
    <h2 class="text-4xl mb-8 text-primary font-bold text-center">
        {projects.projects_title}
    </h2>
    <div class="flex flex-wrap gap-2 justify-center" id="project-filters">
        {
            filters.map((filter) => (
                <button
                    type="button"
                    data-filter={filter}
                    class:list={[
                        "px-4 py-1.5 rounded-full text-sm border cursor-pointer transition-colors",
                        filter === "All"
                            ? "bg-primary text-primary-content border-primary"
                            : "border-base-100/20 text-base-100/70 hover:border-base-100/40",
                    ]}
                >
                    {filter}
                </button>
            ))
        }
    </div>
    <div
        class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
        id="project-grid"
    >
        {
            items.map((item, index) => {
                return <ProjectCard data={item} key={index} />;
            })
        }
    </div>
</section>

<script>
    const filterBar = document.getElementById("project-filters");
    const grid = document.getElementById("project-grid");

    if (filterBar && grid) {
        const buttons = filterBar.querySelectorAll("button[data-filter]");
        const cards = grid.querySelectorAll("[data-category]");

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.getAttribute("data-filter");

                buttons.forEach((b) => {
                    const active = b === button;
                    b.classList.toggle("bg-primary", active);
                    b.classList.toggle("text-primary-content", active);
                    b.classList.toggle("border-primary", active);
                    b.classList.toggle("border-base-100/20", !active);
                    b.classList.toggle("text-base-100/70", !active);
                });

                cards.forEach((card) => {
                    const show =
                        filter === "All" ||
                        card.getAttribute("data-category") === filter;
                    card.classList.toggle("hidden", !show);
                });
            });
        });
    }
</script>
